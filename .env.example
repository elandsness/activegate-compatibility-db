# ActiveGate Compatibility Intelligence - Environment Variables
# Copy this file to .env and adjust values for your environment.
# Never commit your actual .env file — it is listed in .gitignore.

# Neo4j Database Connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-to-a-strong-password
NEO4J_DATABASE=neo4j

# Flask API
PORT=5000
FLASK_DEBUG=0

# Admin protection (set to enable auth on destructive routes)
ADMIN_API_KEY=change-me-to-a-strong-secret
ADMIN_SECRET_HEADER=X-Admin-Secret
